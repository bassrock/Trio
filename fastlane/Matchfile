
GITHUB_REPOSITORY_OWNER ||= ENV["GITHUB_REPOSITORY_OWNER"]

# MATCH_REPO ("owner/name") picks an existing match repo; the default is <owner>/Match-Secrets.
match_repo = ENV["MATCH_REPO"].to_s.empty? ? "#{GITHUB_REPOSITORY_OWNER}/Match-Secrets" : ENV["MATCH_REPO"]

git_url("https://github.com/#{match_repo}.git")

storage_mode("git")

type("appstore")

